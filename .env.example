# ═══════════════════════════════════════════════════════════════════════════════
# Legal AI — Environment Variables Template
#
# Bu dosyayı kopyalayıp ".env" olarak kaydedin:
#   cp .env.example .env
# Ardından tüm değerleri kendi ortamınıza göre doldurun.
# .env dosyası asla Git'e commit edilmemelidir!
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
ENV=development                        # development | production | staging
DEBUG=true                             # Prodüksiyonda false yapın
# Güçlü rastgele bir anahtar üretin: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_KEY_HERE

# ── LLM & Embedding ──────────────────────────────────────────────────────────
OPENAI_API_KEY=                        # OpenAI API anahtarınız (boş = yerel model kullanılır)
LLM_PROVIDER=openai                    # openai | huggingface
LLM_MODEL=gpt-3.5-turbo               # OpenAI model adı (gpt-4o, gpt-4-turbo, vb.)
LLM_LOCAL_MODEL_PATH=TinyLlama/TinyLlama-1.1B-Chat-v1.0  # Huggingface model yolu
LLM_DEVICE=cpu                         # cpu | cuda | mps
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=legalai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=legal_chunks
OPENSEARCH_USER=                       # Boş bırakılırsa auth yok (dev)
OPENSEARCH_PASS=
# docker-compose içindeki OPENSEARCH_INITIAL_ADMIN_PASSWORD ile eşleşmeli
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_STRONG_OPENSEARCH_PASSWORD

# ── RAG ──────────────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ── API Auth ─────────────────────────────────────────────────────────────────
API_KEY=                               # Boş bırakılırsa auth devre dışı

# ── SMTP (Şifre sıfırlama e-postası) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                             # Gmail: uygulama şifresi kullanın
SMTP_PASS=
SMTP_FROM=noreply@legalai.com
FRONTEND_URL=http://localhost:3000
